# Alpaca Paper Trading API Credentials
# Get your free API keys at https://app.alpaca.markets
ALPACA_API_KEY=YOUR_ALPACA_API_KEY_HERE
ALPACA_SECRET_KEY=YOUR_ALPACA_SECRET_KEY_HERE
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2
ALPACA_FEED=iex

# Optional Telegram Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# GitHub Personal Access Token (required for post-session auto-push)
# Create at: https://github.com/settings/tokens ? New token ? repo:contents (write)
# Set this in Render Dashboard ? Environment ? GIT_TOKEN
GIT_TOKEN=YOUR_GITHUB_PAT_HERE
