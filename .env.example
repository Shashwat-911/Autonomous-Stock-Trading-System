# Alpaca Paper Trading API Credentials
# Get your free API keys at https://app.alpaca.markets
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_FEED=iex

# Optional Telegram Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# GitHub Personal Access Token (required for Railway auto-push after each session)
# Create at: https://github.com/settings/tokens → New token → repo:contents (write)
# Set this in Railway Dashboard → Variables → GIT_TOKEN
GIT_TOKEN=your_github_pat_here
